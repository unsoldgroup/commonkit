{
  "name": "mcp-local-relay",
  "version": "0.1.3",
  "description": "Persistent local MCP relay with hot-swap onboarding, cached tool discovery, LaunchAgent management, and status endpoints.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "author": "Unsold Group (https://unsold.group)",
  "homepage": "https://github.com/unsoldgroup/commonkit/tree/main/packages/mcp-local-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unsoldgroup/commonkit.git",
    "directory": "packages/mcp-local-relay"
  },
  "bugs": {
    "url": "https://github.com/unsoldgroup/commonkit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "relay",
    "proxy",
    "launchagent",
    "codex",
    "claude",
    "local-first",
    "posthog"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcp-local-relay": "bin/mcp-local-relay.mjs",
    "mcp-local-relayctl": "bin/mcp-local-relayctl.mjs"
  },
  "files": [
    "dist/src",
    "bin",
    "examples",
    "macos/install-status-bar.sh",
    "macos/uninstall-status-bar.sh",
    "macos/McpLocalRelayStatusBar/Package.swift",
    "macos/McpLocalRelayStatusBar/Sources",
    "docs/ARCHITECTURE.md",
    "docs/STATUS-BAR.md",
    "docs/assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "install:status-bar": "bash macos/install-status-bar.sh",
    "uninstall:status-bar": "bash macos/uninstall-status-bar.sh",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build",
    "test": "node --test dist/test/*.test.js",
    "test:compatibility": "pnpm build && node --test --test-name-pattern=relay-compatibility dist/test/compatibility.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
