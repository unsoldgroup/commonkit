{
  "admin": { "host": "127.0.0.1", "port": 3764, "mcpPath": "/mcp" },
  "updates": { "autoUpgrade": true, "packageManager": "pnpm" },
  "servers": [
    {
      "id": "posthog",
      "name": "PostHog",
      "description": "Product analytics",
      "category": "analytics",
      "enabled": true,
      "mode": "posthog-cli",
      "remote": {
        "type": "streamable_http",
        "url": "https://mcp.posthog.com/mcp",
        "headers": { "Authorization": "env:POSTHOG_TOKEN" }
      },
      "cache": { "toolsTtlMs": 900000, "autoRefreshMs": 900000 }
    }
  ]
}
