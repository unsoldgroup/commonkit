{
  "$defs": {
    "LayerKind": {
      "enum": [
        "public_base",
        "organization_policy",
        "personal_kit",
        "project_loadout",
        "target_overrides"
      ],
      "type": "string"
    },
    "PackageManager": {
      "description": "A package/toolchain backend supported by read-only package observation.",
      "enum": [
        "homebrew",
        "apt",
        "fnm",
        "nvm",
        "rustup"
      ],
      "type": "string"
    },
    "SourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "contentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:\\x00])[^/]+(?:/[^/]+)*$",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "contentDigest"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.commonkit.dev/v1/layer.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/LayerKind"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceMetadata"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "capabilities": true,
        "contextBudget": true,
        "files": true,
        "packages": {
          "items": {
            "additionalProperties": false,
            "description": "An exact, observe-only package declaration.\n\n`id` is the stable merge and report identity, `version` is an exact pin,\n`manager` selects the fixed read-only query backend, and `source` is matched\nagainst `securityPolicy.allowlists.package_sources`.",
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9_-]{0,62}$",
                "type": "string"
              },
              "manager": {
                "$ref": "#/$defs/PackageManager"
              },
              "source": {
                "pattern": "^[a-z][a-z0-9_-]{0,62}$",
                "type": "string"
              },
              "version": {
                "pattern": "^(?!.*[\\s*^~<>=,|]).+$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "manager",
              "source"
            ],
            "title": "PackageDeclaration",
            "type": "object"
          },
          "type": "array"
        },
        "securityPolicy": true
      },
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "source",
    "spec"
  ],
  "title": "LayerDocument",
  "type": "object"
}
