{
  "$defs": {
    "OwnerKind": {
      "enum": [
        "organization",
        "project",
        "user"
      ],
      "type": "string"
    },
    "RecordOwner": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OwnerKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "RecordScope": {
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "organizationId"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.commonkit.dev/v1/portable-context/profile-signing-authority.schema.json",
