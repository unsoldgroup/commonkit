      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/RecordScope"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "owner",
    "scope",
    "contentHash",
    "createdAtUnixMs",
    "provenance"
  ],
  "title": "profile-signing-authority",
  "type": "object"
