{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commonkit.dev/v1/engram-receipt.schema.json",
  "title": "CommonKit Engram movement receipt",
  "description": "Redacted owner-device Engram chunk movement; payloads are never included.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "confirmationId", "reconciliation"],
  "properties": {
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "confirmationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "moved"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "moved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chunkId", "digest", "bytes", "fromTarget", "toTarget"],
            "properties": {
              "chunkId": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "fromTarget": { "type": "string", "minLength": 1 },
              "toTarget": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unresolved": { "type": ["string", "null"] }
      }
    }
  }
}
